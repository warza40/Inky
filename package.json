{
  "name": "rachana-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=1 next dev --hostname 127.0.0.1 --webpack",
    "dev:turbo": "next dev --hostname 127.0.0.1 --turbopack",
    "dev:clean": "rm -rf .next && WATCHPACK_POLLING=1 next dev --hostname 127.0.0.1 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit:deps": "node scripts/audit-deps.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check": "npm run lint && npm run typecheck && npm run knip && npm run format:check && npm run audit:deps && npm run check:links",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
